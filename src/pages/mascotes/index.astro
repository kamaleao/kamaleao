---
import { getCollection } from 'astro:content';
import LayoutMascotes from '../../layouts/LayoutMascotes.astro';
import MascoteCard from '../../components/MascoteCard.astro';

const todosMascotes = await getCollection('blog', ({ data }) => {
  return data.blog === 'mascotes'; 
});

const mascotesOrdenados = todosMascotes.sort((a, b) => b.data.id - a.data.id);
const mascotesPagina1 = mascotesOrdenados.slice(0,189);

const getCleanSlug = (m) => {
  let rawSlug = m.data.slug || m.slug.split('/').pop();
  const prefixoId = `${m.data.id}-`;
  if (rawSlug.startsWith(prefixoId)) {
    rawSlug = rawSlug.replace(prefixoId, '');
  }
  return rawSlug;
};

const searchData = mascotesOrdenados.map(m => ({
  title: m.data.title,
  url: `/mascotes/${m.data.id}/${getCleanSlug(m)}`,
  thumb: m.data.thumb
}));
---

<LayoutMascotes title="• Criação de Mascotes • Fantasias, Bonecos e Mascotes" canonical="https://kamaleao.com/mascotes">
  <div id="content">
    
    <div style="width:100%;" id="bloco-paginacao-topo">
      <table width="100%" border="0" align="center" cellpadding="0" cellspacing="2" style="font-size:30px">
        <tr>
          <td align="left" style="width: 50px;"></td>
          <td align="center">
            <a style="color:#000;text-decoration:none" href="/mascotes">
              <div style="text-align:center;">
                <div style="margin:auto; padding:4px">
                  <img id="logotop" src="https://kamaleao.com/topokas2.svg" alt="Produção de Fantasias" width="190" height="40" border="0" />
                  <div style="font-size: 19px;font-weight:bold;font-variant-caps: all-small-caps; margin-top:-6px;font-stretch: expanded;white-space: nowrap;letter-spacing: 0.0600em;">Criação de Mascotes</div>
                  <div style="font-size: 14px; margin-top:-2px;">Fantasias, Bonecos e Mascotes </div>
                  <div style="font-size: 10px; color: #666">Preço, orçamento, prazo de entrega para confecção de Fantasia personalizada</div>
                </div>
              </div>
            </a>
          </td>
          <td align="right" style="width: 50px;">
            {mascotesOrdenados.length > 189 && (
              <a href="/mascotes/2" style="text-decoration:none;">👉</a>
            )}
          </td>
        </tr>
      </table>  
    </div>

    <table width="100%" border="0" align="center" cellpadding="0" style="border:1px solid #E5BA09;display: flex;flex-wrap: wrap; justify-content: space-around;" cellspacing="0" bgcolor="#FFCC00">
      <tbody>
        <tr>
          <td>
            <form id="search-form" class="mb-3" style="margin: 0;">
              <table border="0" align="center" cellpadding="5" cellspacing="5">
                <tbody>
                  <tr>
                    <td>
                      <input name="search" type="text" class="form-control" id="search-input" style="padding: 5px; border: 1px solid #ccc; width: 200px;">
                    </td>
                    <td>
                      <button type="submit" class="btn btn-primary" style="padding: 5px 10px; cursor: pointer;">Busca🔎</button>
                    </td>
                  </tr>
                </tbody>
              </table>
            </form>
          </td>
        </tr>
      </tbody>
    </table>

    <div id="search-results" style="display: flex; flex-wrap: wrap; justify-content: center; background-color: #FFFFFF; width: 100%;"></div>

    <div id="banner-encomenda">
      <a href="https://api.whatsapp.com/send?l=pt_BR&phone=5598981044545&text=Oi,%20gostaria%20de%20encomendar%20um%20MASCOTE">
        <img src="https://lh3.googleusercontent.com/-KPTIIuRxN-w/ZHK5ZqE7BjI/AAAAAAAABJE/xmhLQcQrUcEV6olgiYNdppXdEQrfIvh_ACNcBGAsYHQ/h1600/TODOS-MASCOTES-REDES.jpg" alt="Produção de Fantasias" style="width:100%; display:block;" />
      </a>
    </div>

    <table id="tabela-grid-mascotes" width="100%" border="0" cellspacing="0" cellpadding="0">
      <tr>
        <td align="center" valign="top" style="display: flex;flex-wrap: wrap; justify-content: center;background-color:#FEEDA7;">
          <div id="grid-mascotes" style="display: contents;">
            {mascotesPagina1.map(mascote => (
              <MascoteCard 
                title={mascote.data.title} 
                url={`/mascotes/${mascote.data.id}/${getCleanSlug(mascote)}`} 
                thumb={mascote.data.thumb} 
              />
            ))}
          </div>
        </td>
      </tr>
    </table>

    <div id="bloco-paginacao-rodape">
      <table width="100%" border="0" align="center" cellpadding="0" cellspacing="2" style="font-size:40px">
        <tr>
          <td align="left"></td>
          <td align="left"> </td>
          <td align="right">
            {mascotesOrdenados.length > 189 && (
              <a href="/mascotes/2" style="text-decoration:none;">👉</a>
            )}
          </td>
        </tr>
      </table>
    </div>

  </div>

  <script is:inline define:vars={{ searchData }}>
    const searchForm = document.getElementById("search-form");
    const searchInput = document.getElementById("search-input");
    const searchResultsDiv = document.getElementById("search-results");
    
    // Elementos que somem durante a busca
    const tabelaGridMascotes = document.getElementById("tabela-grid-mascotes");
    const blocoPaginacaoRodape = document.getElementById("bloco-paginacao-rodape");

    function removeAccents(str) {
      return str.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
    }

    function renderResults(term) {
      const searchValue = removeAccents(term.toLowerCase());
      
      const filtrados = searchData.filter(m => 
        removeAccents(m.title.toLowerCase()).includes(searchValue)
      );

      // Oculta a listagem principal
      if(tabelaGridMascotes) tabelaGridMascotes.style.display = 'none';
      if(blocoPaginacaoRodape) blocoPaginacaoRodape.style.display = 'none';

      if (filtrados.length === 0) {
        searchResultsDiv.innerHTML = '<div style="text-align:center; padding: 20px; font-weight: bold; width: 100%;">Nenhum resultado encontrado.</div>';
      } else {
        let cards = '';
        filtrados.forEach(item => {
          // AQUI ESTÁ O CARD PEQUENO IDÊNTICO AO LEGADO
          cards += `
            <a href="${item.url}" class="post-link" style="text-decoration: none; color: #333; font-size:12px;">
              <div class="post">
                <img src="${item.thumb}" alt="${item.title}" loading="lazy" />
                ${item.title}
              </div>
            </a>
          `;
        });
        searchResultsDiv.innerHTML = cards;
      }
    }

    searchForm.addEventListener("submit", (e) => {
      e.preventDefault();
      renderResults(searchInput.value);
    });

    searchInput.addEventListener("input", (e) => {
      if(e.target.value === '') {
         window.location.reload();
      }
    });
  </script>
</LayoutMascotes>

<style>
  /* CSS DOS CARDS PEQUENOS DA BUSCA E RECENTES (SEM ESTRELINHAS) */
  .post-link { text-decoration: none; color: #333; font-size: 12px; }
  .post {
    font-family: Segoe UI, Tahoma, Geneva, Verdana, sans-serif;
    border-radius: 5px;
    box-shadow: 0px 0px 10px rgba(0,0,0,0.1);
    border: 1px solid #ccc;
    text-align: center;
    background-color: #FFFFFF;
    padding: 4px;
    margin: 4px;
    width: 110px;
    height: 160px;
    max-height: 160px;
    text-overflow: ellipsis;
    overflow: hidden;
    display: block;
    float: left;
    transition: background-color 0.3s ease-in-out;
    line-height: 1.1;
  }
  .post:hover { background-color: #FFF9D7; }
  .post img {
    width: 106px;
    height: 106px;
    object-fit: cover;
    margin-bottom: 4px;
  }
</style>