<style is:global>
  /* CSS GLOBAL DO GOSPEL (Legado) */
  body {
    font-size: 16.4px;
    font-family: Arial, Helvetica, sans-serif;
    color: #333333;
    margin: 0px 0px 0px 0px;
    overflow-x: hidden;
  }
  
  .fb_iframe_widget, .fb_iframe_widget span, .fb_iframe_widget iframe[style] {
    width: 100% !important;
  }
  
  .small { font-size: 12px; }
  .large { font-size: 20px; }
  p { margin: 0px 0px 0px 0px; }
  
  h1 {
    margin: 0px 0px 0px 0px;
    text-decoration: none;
    font-family: 'Francois One', sans-serif !important;
    font-size: 26px;
    outline: 0px;
    padding: 0px;
    font-weight: normal;
    letter-spacing: -0.06em;
    line-height: 28px;
  }
  
  h2 { margin: 0px; font-size: 16px; font-weight: normal; line-height: 18px; }
  h3 { margin: 0px; font-size: 10px; font-weight: normal; letter-spacing: -0.06em; line-height: 12px; }
  
  a { color: #0095F6; text-decoration: none; }
  a:hover { text-decoration: underline; }
  a:focus, a:active { text-decoration: underline; }

  /* STRUCTURE */
  #pagewrap { width: 1124px; margin: 0px 0px 0px 0px; }
  #content { width: 90%; }
  #footer { clear: both; }
  #logo { width: 100%; background-size: 100%; }

  /* UTILIDADES LEGADAS */
  .uiLinkSubtle { font-size: 9px; color: #808080; }
  .alert { color: red; }
  .alertpink { font-size: 9px; color: #FF69B4; }
  .a3 { font-size: 11px; }

  /* CARDS PEQUENOS DE BUSCA (Idênticos ao Legado) */
  .post-link { text-decoration: none; color: #333; font-size: 12px; }
  .post {
    font-family: Segoe UI, Tahoma, Geneva, Verdana, sans-serif;
    border-radius: 5px;
    box-shadow: 0px 0px 10px rgba(0,0,0,0.1);
    border: 1px solid #ccc;
    text-align: center;
    background-color: #FFFFFF;
    padding: 4px;
    margin: 4px;
    width: 110px;
    height: 160px;
    max-height: 160px;
    text-overflow: ellipsis;
    overflow: hidden;
    display: block;
    float: left;
    transition: background-color 0.3s ease-in-out;
    line-height: 1.1;
  }
  .post:hover { background-color: #FFF9D7; }
  .post img { width: 106px; height: 106px; object-fit: cover; margin-bottom: 4px; }

  /* SPINNER PARA A BUSCA AJAX */
  @keyframes spinner-border { to { transform: rotate(360deg); } }
  .spinner-border {
    display: inline-block; width: 2rem; height: 2rem; vertical-align: text-bottom;
    border: .25em solid currentColor; border-right-color: transparent;
    border-radius: 50%; animation: spinner-border .75s linear infinite;
  }

  /* MEDIA QUERIES ORIGINAIS */
  @media screen and (max-width: 980px) {
    #pagewrap { width: auto; float: none; }
    #content { width: auto; float: none; }
  }

  @media screen and (max-width: 700px) {
    #content { width: auto; float: none; }
  }

  @media screen and (max-width: 480px) {
    #banner { width: 100%; background-size: 100% 70px; }
    .none { display: none; }
    #pagewrap { width: 100%; border: 0px; box-shadow: none; }
    #content { width: 100%; }
    img { max-width: 100%; height: auto; }
    td, tr, table, div, iframe { max-width: 100% !important; padding-left: 0px; margin-left: 0px; padding-right: 0px; margin-right: 0px; }
    div { text-align: center; }
    p { margin: 10px; overflow: visible; }
    iframe { margin: 0px; }
    #busca-banner { display: none; }
  }
</style>